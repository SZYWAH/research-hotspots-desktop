# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=research_hotspots
DB_CHARSET=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=research_hotspots
MYSQL_CHARSET=utf8mb4

# DeepSeek / API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://dpapi.cn/v1
DEEPSEEK_MODEL_NAME=deepseek-V3

# Frontend / Tauri AI config read by Vite
VITE_DEEPSEEK_API_KEY=your_api_key_here
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-chat

# Paths
EXPORT_DIR=/app/data/exports
FONT_PATH=/app/assets/fonts/SIMHEI.ttf
MERMAID_JS_PATH=/app/assets/js/mermaid.min.js
CHROME_DRIVER_PATH=/usr/bin/chromedriver

# Crawl range
CRAWL_START_YEAR=2020
CRAWL_END_YEAR=2026

# CNKI desktop Selenium settings
CNKI_CHROME_DRIVER_PATH=/path/to/chromedriver.exe
CNKI_CHROME_USER_DATA_DIR=
CNKI_CHROME_PROFILE=Default
CNKI_HEADLESS=1
CNKI_WAIT_TIMEOUT=20
CNKI_PAGELOAD_TIMEOUT=45
CNKI_IMPLICIT_WAIT=2
CNKI_DEBUG_DIR=/app/data/exports
