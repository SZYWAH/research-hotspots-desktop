{
  "name": "research-hotspots-desktop",
  "private": true,
  "version": "0.21.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "visual:galaxy": "node scripts/app17_visual_review.mjs serve",
    "visual:galaxy:snapshot": "node scripts/app17_visual_review.mjs snapshot",
    "visual:galaxy:paper-audit": "node --experimental-strip-types scripts/app17_paper_endpoint_audit.mjs",
    "audit:hotspot-library": "node --experimental-strip-types scripts/hotspot_library_evidence_audit.mjs",
    "audit:v20-cache": "node scripts/v20_snapshot_cache_audit.mjs",
    "audit:backup-restore": "node scripts/v20_backup_restore_audit.mjs",
    "audit:windows-release": "node scripts/windows_release_audit.mjs",
    "audit:agent-persistence": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin audit_agent_persistence -- --root src-tauri/target/agent-persistence-audit",
    "audit:agent-executor": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin audit_agent_executor -- --root src-tauri/target/agent-executor-audit",
    "audit:agent-model-gateway": "cargo test --manifest-path src-tauri/Cargo.toml --test agent_model_gateway -- --nocapture",
    "audit:agent-report-golden": "node --experimental-strip-types scripts/agent_report_golden_audit.mjs",
    "audit:agent-live": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin audit_agent_live --",
    "audit:windows-first-run": "node --experimental-strip-types scripts/analysis_progress_audit.mjs && cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin audit_windows_first_run -- --root src-tauri/target/windows-first-run-audit --seed release-assets/default-library/research-hotspots-v7.sqlite --manifest release-assets/default-library/default-library-manifest.json",
    "audit:windows-install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/windows_install_smoke.ps1",
    "ai:bridge-env": "node scripts/v20_ai_env_bridge.mjs",
    "ai:live-smoke": "node scripts/v20_ai_live_report_smoke.mjs",
    "build": "tsc -b && vite build",
    "convert:bibliography": "node scripts/v20_bibliography_to_jsonl.mjs",
    "acceptance:bibliography-check": "node scripts/v20_bibliography_conversion_check.mjs",
    "discover:real-data": "node scripts/v20_real_data_discovery.mjs",
    "report:audit-check": "node scripts/v20_report_export_audit_check.mjs",
    "report:evidence-check": "node scripts/v20_hotspot_evidence_report_check.mjs",
    "acceptance:evidence-chain-check": "node scripts/v20_evidence_chain_check.mjs",
    "acceptance:v20": "powershell -ExecutionPolicy Bypass -File scripts/v20_acceptance_check.ps1",
    "acceptance:status": "node scripts/v20_goal_readiness_audit.mjs",
    "acceptance:readiness-check": "node scripts/v20_goal_readiness_audit_check.mjs",
    "acceptance:runbook": "node scripts/v20_terminal_runbook.mjs",
    "acceptance:runbook-quote-check": "node scripts/v20_terminal_runbook_path_quote_check.mjs",
    "acceptance:require-complete": "node scripts/v20_goal_readiness_audit.mjs --require-complete",
    "acceptance:validate-config": "node scripts/v20_terminal_config_validate.mjs",
    "acceptance:storage-check": "node scripts/v20_storage_preflight.mjs",
    "acceptance:capacity-plan": "node scripts/v20_capacity_plan.mjs",
    "acceptance:capacity-plan-check": "node scripts/v20_capacity_plan_check.mjs",
    "acceptance:source-manifest": "node scripts/v20_source_manifest.mjs",
    "acceptance:source-manifest-check": "node scripts/v20_source_manifest_check.mjs",
    "acceptance:config-check": "node scripts/v20_terminal_config_validator_check.mjs",
    "acceptance:config-from-discovery": "node scripts/v20_terminal_config_from_discovery.mjs",
    "acceptance:config-from-discovery-check": "node scripts/v20_terminal_config_from_discovery_check.mjs",
    "acceptance:prepare-terminal": "node scripts/v20_terminal_prepare.mjs",
    "acceptance:prepare-terminal-check": "node scripts/v20_terminal_prepare_check.mjs",
    "acceptance:final-gate-check": "node scripts/v20_final_gate_direct_evidence_check.mjs",
    "acceptance:final": "node scripts/v20_final_acceptance_gate_runner.mjs",
    "acceptance:terminal": "node scripts/v20_final_acceptance_gate_runner.mjs --codex-terminal-ready",
    "acceptance:terminal-config": "node scripts/v20_acceptance_from_config.mjs",
    "import:library": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin import_library --",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release:windows:full": "node scripts/windows_release.mjs full",
    "release:windows:lite": "node scripts/windows_release.mjs lite",
    "release:windows": "node scripts/windows_release.mjs all",
    "export:star-map": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin export_star_map --",
    "export:hotspot-evidence": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin export_hotspot_evidence --",
    "export:hotspot-report": "node scripts/v20_hotspot_report_export.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
