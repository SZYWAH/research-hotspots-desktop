{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V20 Terminal Acceptance Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["libraryPath"],
  "properties": {
    "$schema": { "type": "string" },
    "libraryPath": { "type": "string", "minLength": 1 },
    "convertedImportDir": { "type": "string", "minLength": 1 },
    "minValidRows": { "type": "integer", "minimum": 1 },
    "maxInvalidRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxDuplicateRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "databaseDir": { "type": "string", "minLength": 1 },
    "databasePath": { "type": "string", "minLength": 1 },
    "importBeforeAudit": { "type": "boolean" },
    "minImportedRows": { "type": "integer", "minimum": 1 },
    "maxMissingAbstractRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxMissingYearRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxQueryMs": { "type": "integer", "minimum": 1 },
    "minClusters": { "type": "integer", "minimum": 1 },
    "exportStarMap": { "type": "boolean" },
    "starMapPath": { "type": "string", "minLength": 1 },
    "minStarMapHotspots": { "type": "integer", "minimum": 1 },
    "minStarMapEvidenceIds": { "type": "integer", "minimum": 1 },
    "minStarMapLinks": { "type": "integer", "minimum": 0 },
    "minStarMapEvidenceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "minStarMapEvolutionCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "minStarMapSourceDistributionCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "rejectSampleStarMapSignals": { "type": "boolean" },
    "exportHotspotEvidence": { "type": "boolean" },
    "hotspotEvidencePath": { "type": "string", "minLength": 1 },
    "hotspotEvidenceMarkdownPath": { "type": "string", "minLength": 1 },
    "minHotspotRepresentativePapers": { "type": "integer", "minimum": 1 },
    "generateHotspotReport": { "type": "boolean" },
    "generatedHotspotReportPath": { "type": "string", "minLength": 1 },
    "generatedHotspotReportHtmlPath": { "type": "string", "minLength": 1 },
    "minHotspotReportPapers": { "type": "integer", "minimum": 1 },
    "reportPath": { "type": "string", "minLength": 1 },
    "minReportCitations": { "type": "integer", "minimum": 1 },
    "minReportReferences": { "type": "integer", "minimum": 1 },
    "minReportChars": { "type": "integer", "minimum": 1 },
    "uiSmokePath": { "type": "string", "minLength": 1 },
    "aiLiveSmokePath": { "type": "string", "minLength": 1 },
    "requireLiveAi": { "type": "boolean" },
    "requireTerminalReady": { "type": "boolean" },
    "skipBaseline": { "type": "boolean" },
    "runPressureTest": { "type": "boolean" },
    "runTauriBuild": { "type": "boolean" },
    "launchExe": { "type": "boolean" }
  }
}
