{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Hotspots Desktop",
  "version": "0.21.0-beta.1",
  "identifier": "com.local.research-hotspots-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Research Hotspots Desktop",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Research Hotspots Desktop",
    "copyright": "Copyright © 2026 Research Hotspots Desktop",
    "shortDescription": "Local-first research hotspot analysis and scientific literature exploration",
    "longDescription": "Research Hotspots Desktop provides local literature management, research hotspot analysis, evidence reports, and an interactive scientific galaxy visualization.",
    "icon": ["icons/icon.ico"],
    "externalBin": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
