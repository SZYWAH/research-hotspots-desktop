{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidera",
  "version": "0.22.0-beta.4",
  "identifier": "com.local.research-hotspots-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sidera",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sidera",
    "copyright": "Copyright © 2026 Sidera",
    "shortDescription": "Local-first research agent and scientific knowledge galaxy",
    "longDescription": "Sidera combines a local-first research agent, scientific literature workflows, evidence reports, and an interactive knowledge galaxy.",
    "icon": ["icons/icon.ico"],
    "externalBin": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
